# ============================================================
# Wayka — example environment variables
# ------------------------------------------------------------
# Copy to `.env` (backend, read by python-dotenv at repo root)
# and to `frontend/.env.local` (Next.js auto-loads).
# Never commit real secrets.
# ============================================================

# ============ Backend (Django) ============

# Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-real-env

# Django debug flag — set to False in production
DJANGO_DEBUG=True

# Comma-separated list
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins permitted to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ============ Frontend (Next.js) ============

# Base URL of the Django API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WhatsApp number used for order redirects (E.164 format, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=+50688887777

# Analytics (leave blank locally; set in deployed environments)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
